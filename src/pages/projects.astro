---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProjectGrid from '../components/ProjectGrid'
import ProjectHeroMotion from '../components/ProjectHeroMotion'
import { projectSnapshot } from '../data/projects'
import blueprint from '../assets/project-blueprint.png'
---

<BaseLayout title="项目 — UPINKING" description="UPINKING 正在构建的开源软件与实验。">
  <header class="projects-hero">
    <img src={blueprint.src} alt="抽象的工程蓝图空间" />
    <div class="project-motion-layer" aria-hidden="true"><ProjectHeroMotion client:load /></div>
    <div class="projects-shade"></div>
    <div class="page-frame projects-head-copy">
      <div class="eyebrow">Selected projects / 03</div>
      <h1 class="display-title">把想法<br />做成工具</h1>
      <p class="page-intro">从写笔记、读外文到记录学习，把日常遇到的问题做成可以使用的软件。这里是我持续维护的三个公开项目。</p>
    </div>
  </header>
  <section class="page-frame projects-list">
    <ProjectGrid fallback={projectSnapshot} client:load />
  </section>
</BaseLayout>

<style is:global>
  .projects-hero { --project-x: 0px; --project-y: 0px; --project-scroll: 0; position: relative; min-height: 380px; overflow: hidden; perspective: 1100px; }
  .projects-hero > img { position: absolute; z-index: 0; inset: -20px; width: calc(100% + 40px); height: calc(100% + 40px); object-fit: cover; transform: translate3d(calc(var(--project-x) * -.42), calc(var(--project-y) * -.42 + var(--project-scroll) * 22px), -20px) scale(calc(1.045 - var(--project-scroll) * .02)); }
  .project-motion-layer { position: absolute; z-index: 1; inset: 0; overflow: hidden; pointer-events: none; transform: translate3d(calc(var(--project-x) * .3), calc(var(--project-y) * .3), 36px); }
  .project-motion-layer astro-island { display: block; width: 100%; height: 100%; }
  .project-field-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: calc(.88 - var(--project-scroll) * .35); pointer-events: none; }
  .projects-shade { position: absolute; z-index: 2; inset: 0; background: linear-gradient(90deg, rgba(7,13,20,.98), rgba(7,13,20,.5) 58%, rgba(7,13,20,.12)), linear-gradient(0deg, var(--ink), transparent 40%); }
  .projects-head-copy { position: relative; z-index: 3; padding-top: 64px; padding-bottom: 48px; transform: translate3d(calc(var(--project-x) * .1), calc(var(--project-y) * .1 + var(--project-scroll) * 30px), 54px); opacity: calc(1 - var(--project-scroll) * .38); }
  .projects-list { padding-top: 60px; }
  .project-source { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; color: #8c9aab; font-size: 12px; animation: project-row-enter .52s cubic-bezier(.16,.76,.18,1) both; }
  .project-source > a { display: flex; align-items: center; gap: 7px; color: var(--blue-soft); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .project-card { min-width: 0; display: flex; flex-direction: column; padding: 32px; border: 1px solid var(--line); background: linear-gradient(145deg, #101e2d, #0a131e 75%); transition: border-color .2s ease; }
  .project-card:hover { border-color: #6383ab; }
  .project-card-top { display: flex; gap: 16px; align-items: center; justify-content: space-between; }
  .project-number { color: var(--orange); font-family: var(--serif); font-size: 24px; }
  .project-language { color: var(--blue-soft); font-size: .8125rem; text-align: right; }
  .project-card h2 { margin: 28px 0 14px; font-family: var(--serif); font-size: clamp(28px, 3vw, 38px); overflow-wrap: anywhere; }
  .project-card h2 a:hover { color: var(--blue-soft); }
  .project-card h3 { margin: 0; font-size: 18px; line-height: 1.65; font-weight: 500; }
  .project-card p { color: #b6c2d1; font-size: 1rem; line-height: 1.9; }
  .project-workflow { list-style: none; counter-reset: steps; margin: 16px 0 8px; padding: 18px 0; display: grid; gap: 12px; border-block: 1px solid var(--line); }
  .project-workflow li { counter-increment: steps; display: flex; gap: 12px; align-items: baseline; font-size: .875rem; line-height: 1.6; }
  .project-workflow li::before { content: '0' counter(steps); color: var(--blue-soft); font-size: .8125rem; }
  .project-features { color: #b6c2d1; font-size: .875rem; line-height: 1.9; padding-left: 20px; margin: 18px 0 28px; }
  .project-features li::marker { color: var(--orange); }
  .project-foot { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; color: #a5b4c6; font-size: .8125rem; }
  .project-foot span, .project-foot a { display: inline-flex; align-items: center; gap: 6px; }
  .project-foot a { margin-left: auto; min-height: 44px; color: var(--blue-soft); font-size: .875rem; }
  .project-card:last-child { grid-column: 1 / -1; }
  @media (max-width: 1000px) { .project-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .projects-hero { min-height: 340px; } .projects-head-copy { padding-top: 44px; } .projects-list { padding-top: 28px; } .project-card { padding: 24px; } .project-motion-layer { display: none; } .projects-hero > img, .projects-head-copy { transform: none !important; opacity: 1 !important; } }
  @media (prefers-reduced-motion: reduce) { .project-field-canvas { display: none; } .projects-hero > img, .projects-head-copy { transform: none !important; opacity: 1 !important; } }
</style>
